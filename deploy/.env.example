# 复制成 .env 后修改。不要提交真实值到 Git。

# 首次启动时用来创建第一个管理员 key。
# 生成方式：python3 -c "import secrets;print('wb_ad_'+secrets.token_urlsafe(24))"
# 拿到后在本地执行 `wb key create <名字> --role writer` 创建日常用的 key，
# 然后可以从这里删掉这行。
V8WB_BOOTSTRAP_ADMIN_KEY=

# 语雀自动同步
V8WB_YUQUE_ENABLED=false
V8WB_YUQUE_BOOK=seeyonkk/v8
# 公开知识库留空即可。私有知识库需要语雀个人 access token
V8WB_YUQUE_TOKEN=
# 同步间隔（分钟）。1440 = 每天一次
V8WB_YUQUE_INTERVAL_MIN=1440
